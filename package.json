{
  "name": "images-cheminfo-org",
  "version": "0.0.0",
  "description": "Drop images or folders, crop, rotate, adjust colours, resize and compress them to JPEG or PNG, in the browser.",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "vite build",
    "check-tokens": "node node_modules/react-cheminfo/bin/check-tokens.mjs src",
    "check-types": "tsc --noEmit",
    "dev": "vite",
    "eslint": "eslint .",
    "eslint-fix": "eslint . --fix",
    "og-image": "node scripts/generateOgImage.ts",
    "prettier": "prettier --check .",
    "prettier-write": "prettier --write .",
    "preview": "vite preview",
    "test": "npm run test-only && npm run check-types && npm run check-tokens && npm run eslint && npm run prettier",
    "test-e2e": "playwright test",
    "test-only": "vitest run --coverage"
  },
  "dependencies": {
    "@blueprintjs/core": "^6.18.0",
    "@blueprintjs/icons": "^6.13.0",
    "@blueprintjs/select": "^6.3.4",
    "@preact/signals-react": "^3.12.0",
    "@zip.js/zip.js": "^2.15.0",
    "fifo-logger": "^2.0.1",
    "file-collection": "^6.7.0",
    "react": "^19.3.0",
    "react-cheminfo": "^0.14.0",
    "react-dom": "^19.3.0",
    "react-roi": "^3.2.1",
    "react-science": "^23.1.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^4.1.10",
    "@zakodium/tsconfig": "^1.0.5",
    "eslint": "^9.39.5",
    "eslint-config-zakodium": "^20.1.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "vite": "^8.3.0",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}

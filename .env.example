# Copy this file to .env.
# Local dev: leave COMPOSE_FILE commented, then npm run dev (Vite serves on 10915).
# Docker:    uncomment one COMPOSE_FILE line, then docker compose up -d.

# Deployment mode: uncomment exactly ONE line to choose how the service is
# exposed. With none uncommented, docker compose uses compose.yaml by default.
# COMPOSE_FILE=compose.yaml             # port-published (publishes PORT on the host)
# COMPOSE_FILE=compose.traefik.yaml     # behind a Traefik reverse proxy
# COMPOSE_FILE=compose.cloudflared.yaml # behind a Cloudflare Tunnel (no published port)

# The image every compose file runs.
IMAGE_NAME=ghcr.io/cheminfo/images.cheminfo.org
IMAGE_TAG=latest          # rewritten by the server's deploy script - do not edit by hand

# Host port the site is published on (compose.yaml only); the container always
# listens on 80. Derived from the creation date (2026-09-15 → 60915 → 10915),
# and used by the Vite dev server too.
PORT=10915

# The audience-measurement snippet, injected verbatim at the end of the <head>
# of every page the container serves. Unset means nothing is loaded; a dev run
# never tracks. Get this site's own website id from https://datami.cheminfo.org.
# TRACKING_SCRIPT=<script defer src="https://datami.cheminfo.org/script.js" data-website-id="00000000-0000-0000-0000-000000000000"></script>

# Cloudflare Tunnel token (compose.cloudflared.yaml only).
# openssl rand -hex 32 does not apply: copy the token from the Cloudflare dashboard.
# TUNNEL_TOKEN=
